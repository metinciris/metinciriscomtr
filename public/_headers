# Assets Cache policy
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Standard static assets
/img/*
  Cache-Control: public, max-age=604800
/data/*
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800

# HTML and JSON (Stale-While-Revalidate pattern)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/manifest.json
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
